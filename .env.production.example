# Production settings. On the server: cp .env.production.example .env
# and fill in every empty value. Never commit the filled-in file.

# docker compose uses the production file without -f
COMPOSE_FILE=docker-compose.prod.yml

# Domain of the API. Its DNS A record must point to the server.
DOMAIN=api.your-project.site
PUBLIC_BASE_URL=https://${DOMAIN}

# Domain of the Flutter web app (www.<domain> redirects to it).
WEB_DOMAIN=your-project.site

# Browser origins of the web app allowed to call the API (comma-separated).
# localhost lets you run the Flutter web app locally against this server.
CORS_ALLOWED_ORIGINS=https://your-project.site,https://www.your-project.site,http://localhost:*

# PostgreSQL runs in Docker on the same server and is not exposed.
# Generate the password with: openssl rand -hex 24
DB_USER=rental_user
DB_PASSWORD=
DB_NAME=rental_platform
DATABASE_URL=postgres://${DB_USER}:${DB_PASSWORD}@postgres:5432/${DB_NAME}?sslmode=disable

# Generate each with: openssl rand -hex 32 (three different values)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
EMAIL_VERIFICATION_SECRET=

# Email delivery (Yandex Mail application password)
SMTP_ENABLED=true
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_TLS_MODE=tls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="Rental Platform"

# Timeweb Cloud S3: keys of the storage, buckets created in the control panel.
# Check the endpoint and region on the bucket page in the panel.
S3_ENDPOINT=s3.twcstorage.ru
S3_REGION=ru-1
S3_USE_SSL=true
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Bucket names are global in Timeweb, so they usually get a random suffix.
S3_BUCKET=
BACKUP_BUCKET=

# Daily database backup at this hour (UTC; 0 = 03:00 Moscow), keep the last N
BACKUP_HOUR_UTC=0
BACKUP_KEEP=14
