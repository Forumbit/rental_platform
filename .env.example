# PostgreSQL credentials
DB_USER=rental_user
DB_PASSWORD=secret-key
DB_NAME=rental_platform

# PostgreSQL host port
POSTGRES_PORT=5432

# DB url for golang project
DATABASE_URL=postgres://${DB_USER}:${DB_PASSWORD}@localhost:${POSTGRES_PORT}/${DB_NAME}?sslmode=disable

# Integration tests: each test creates and drops its own schema,
# so the development database is safe to reuse.
TEST_DATABASE_URL=${DATABASE_URL}

# Generate two different values with: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Initial account, created by cmd/seed-user
SEED_USER_EMAIL=owner@rental.test
SEED_USER_PASSWORD=
SEED_USER_FULL_NAME="Rental Owner"

# Email verification: generate a separate value with openssl rand -hex 32
EMAIL_VERIFICATION_SECRET=
PUBLIC_BASE_URL=http://localhost:8080

# Yandex Mail: enable mail-client access and create a mail application password
SMTP_ENABLED=false
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_TLS_MODE=tls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="Rental Platform"

# Listing photos: S3-compatible storage. Locally it is SeaweedFS from docker-compose.
# Generate the secret with: openssl rand -hex 32
S3_PORT=8333
S3_ENDPOINT=localhost:${S3_PORT}
S3_ACCESS_KEY=rental-local
S3_SECRET_KEY=
S3_BUCKET=listing-images
S3_USE_SSL=false
# S3 integration tests create their own bucket in the same storage
TEST_S3_ENDPOINT=${S3_ENDPOINT}
TEST_S3_ACCESS_KEY=${S3_ACCESS_KEY}
TEST_S3_SECRET_KEY=${S3_SECRET_KEY}
